{
    "name": "@dpuse/dpuse-tool-d3-visualiser",
    "version": "1.0.111",
    "private": false,
    "description": "A TypeScript wrapper for D3, TanStack Charts, and Unovis that implements the Data Positioning chart-rendering interface, providing ERD (dagre), Sankey (d3-sankey), chord (Unovis), network (d3-force), tree (d3-hierarchy), and bar chart (TanStack Charts) renderers.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-tool-d3-visualiser/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-tool-d3-visualiser.git"
    },
    "module": "./dist/dpuse-tool-d3-visualiser.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "import": "./dist/dpuse-tool-d3-visualiser.es.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20261006.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "node -e \"import('@dpuse/dpuse-development').then(m => m.buildProject())\"",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('Apache-2.0;BSD-3-Clause;ISC;MIT', true))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && node -e \"import('@dpuse/dpuse-development').then(m => m.triggerGitHubRelease())\"",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "@dpuse/dpuse-shared": "^1.0.116",
        "@tanstack/charts": "^1.0.0",
        "@unovis/ts": "^1.7.1",
        "d3-drag": "^3.0.0",
        "d3-force": "^3.0.0",
        "d3-hierarchy": "^3.1.2",
        "d3-sankey": "^0.12.3",
        "d3-scale": "^4.0.2",
        "d3-selection": "^3.0.0",
        "d3-shape": "^3.2.0",
        "d3-zoom": "^3.0.0"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.122",
        "@dpuse/eslint-config-dpuse": "^1.0.132",
        "@types/d3-drag": "^3.0.7",
        "@types/d3-force": "^3.0.10",
        "@types/d3-hierarchy": "^3.1.7",
        "@types/d3-sankey": "^0.12.5",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-selection": "^3.0.12",
        "@types/d3-shape": "^3.2.0",
        "@types/d3-zoom": "^3.0.9",
        "@types/node": "^26.6.4",
        "eslint": "^10.12.0",
        "happy-dom": "^20.14.5",
        "prettier": "^3.9.9",
        "sonda": "^0.14.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.3",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.3",
        "wrangler": "^4.148.0"
    },
    "overrides": {
        "d3-array": "^3.2.4",
        "d3-path": "^3.1.0",
        "d3-shape": "^3.2.0",
        "internmap": "^2.0.3"
    }
}
